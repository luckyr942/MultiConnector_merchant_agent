# ─── WooCommerce ────────────────────────────────────────────────────────────────
WOOCOMMERCE_URL=https://your-store.com
WOOCOMMERCE_CONSUMER_KEY=ck_XXXXXXXXXXXX
WOOCOMMERCE_CONSUMER_SECRET=cs_XXXXXXXXXXXX

# ─── Freshdesk ─────────────────────────────────────────────────────────────────
FRESHDESK_DOMAIN=yourcompany
FRESHDESK_API_KEY=XXXXXXXXXXXXXXXXXXXX

# ─── Zoho Inventory ────────────────────────────────────────────────────────────
ZOHO_ORG_ID=XXXXXXXXXX
ZOHO_CLIENT_ID=XXXXXXXXXXXX
ZOHO_CLIENT_SECRET=XXXXXXXXXXXX
ZOHO_REFRESH_TOKEN=XXXXXXXXXXXX

# ─── Unicommerce ───────────────────────────────────────────────────────────────
UNICOMMERCE_URL=https://yourstore.unicommerce.com
UNICOMMERCE_USERNAME=your_username
UNICOMMERCE_PASSWORD=your_password
UNICOMMERCE_CLIENT_ID=your_client_id

# ─── Connector Settings ────────────────────────────────────────────────────────
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20
MAX_RETRIES=3
REQUEST_TIMEOUT_MS=8000
ENABLE_PII_MASKING=true

# ─── Development ───────────────────────────────────────────────────────────────
# Set to "true" to use offline fixtures instead of real APIs
USE_MOCK_STORE=true
